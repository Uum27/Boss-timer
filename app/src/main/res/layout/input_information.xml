<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 名称 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="@string/input_name_label"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- 重置时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="@string/input_reset_time_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/spawn_hour"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:hint="@string/input_hour_hint"/>

        <EditText
            android:id="@+id/spawn_minute"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:hint="@string/input_minute_hint"/>

        <EditText
            android:id="@+id/spawn_second"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:hint="@string/input_second_hint"/>
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- 自动重置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="@string/input_auto_reset_label"
            android:textSize="16sp"/>

        <CheckBox
            android:id="@+id/chk_auto_reset"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:checked="true"/>
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- 提前提醒时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="@string/input_advance_notify_label"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/notify_hour"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:hint="@string/input_hour_hint"/>

        <EditText
            android:id="@+id/notify_minute"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:hint="@string/input_minute_hint"/>

        <EditText
            android:id="@+id/notify_second"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:hint="@string/input_second_hint"/>
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- 悬浮窗中显示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="@string/input_show_in_float_label"
            android:textSize="16sp"/>

        <CheckBox
            android:id="@+id/chk_show_in_float"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:checked="true"/>
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- 备注 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="@string/input_extra_label"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/input_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:hint="@string/edit_extra_hint"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>

</LinearLayout>