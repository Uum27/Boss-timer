<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:minWidth="260dp"
    android:layout_height="wrap_content"
    android:background="#30000000"
    android:orientation="vertical">

    <!-- 拖动图标 -->
    <ImageButton
        android:id="@+id/btn_floating_window_move"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:src="@drawable/move"
        android:scaleType="centerInside" />

    <!-- 房间信息栏（共享模式显示） -->
    <LinearLayout
        android:id="@+id/room_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#602196F3"
        android:padding="2dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/favorite_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_favorite_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☆"
                android:textSize="14sp"
                android:textColor="#FFD700" />

            <TextView
                android:id="@+id/tv_favorite_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favorite"
                android:textSize="10sp"
                android:textColor="#FFD700"
                android:paddingStart="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_room_bar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFD700"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 标题栏 -->
    <LinearLayout
        android:id="@+id/floating_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="#40000000">

        <TextView
            android:id="@+id/tv_mode_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#FFD700"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_title_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="70"
            android:minWidth="70dp"
            android:gravity="center"
            android:text="@string/float_title_name"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_title_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="90"
            android:minWidth="90dp"
            android:gravity="center"
            android:text="@string/float_title_refresh"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_title_remaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="70"
            android:minWidth="70dp"
            android:gravity="center"
            android:text="@string/float_title_remaining"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_title_reset"
            android:layout_width="5dp"
            android:layout_height="wrap_content"
            android:layout_weight="30"
            android:gravity="center"
            android:minWidth="30dp"
            android:text="@string/float_title_reset"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/floating_recycler_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#50000000"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- 房间信息栏 -->
    <LinearLayout
        android:id="@+id/room_info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#40000000"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/room_info_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_leave_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room_leave"
            android:textSize="11sp"
            android:textColor="#FFAAAA"
            android:paddingStart="10dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <!-- 加入房间面板 -->
    <LinearLayout
        android:id="@+id/join_room_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#50000000"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/join_room_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/join_room_title"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="4dp" />

        <EditText
            android:id="@+id/join_room_id"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:hint="@string/join_room_id_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAFFFFFF"
            android:textSize="12sp"
            android:inputType="number"
            android:maxLength="3"
            android:background="#30000000"
            android:paddingStart="8dp" />

        <EditText
            android:id="@+id/join_room_password"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:hint="@string/room_password_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAFFFFFF"
            android:textSize="12sp"
            android:inputType="textPassword"
            android:maxLength="20"
            android:background="#30000000"
            android:paddingStart="8dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/join_room_name"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:hint="@string/join_room_name_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAFFFFFF"
            android:textSize="12sp"
            android:inputType="text"
            android:maxLength="10"
            android:background="#30000000"
            android:paddingStart="8dp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/btn_join_confirm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="30dp"
                android:text="@string/join_room_btn"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent" />

            <Button
                android:id="@+id/btn_join_cancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="30dp"
                android:text="@string/dialog_button_cancel"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <!-- 房间列表面板 -->
    <LinearLayout
        android:id="@+id/room_list_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#50000000"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- 底部按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btn_share"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="@string/float_button_share"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_float_bg" />

        <Button
            android:id="@+id/btn_minimize"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="@string/float_button_minimize"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_float_bg" />

        <Button
            android:id="@+id/btn_room"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="@string/float_button_room"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_float_bg" />
    </LinearLayout>

</LinearLayout>
